[Unit]
Description=MineFeed Discord relay bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minefeed
WorkingDirectory=/opt/minefeed-bot
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/minefeed-bot
# A dedicated writable directory survives restarts and deployments.
StateDirectory=minefeed-bot
StateDirectoryMode=0750
MemoryMax=256M

[Install]
WantedBy=multi-user.target
