# Copy to .env (chmod 600). Never commit the real file.
DISCORD_BOT_TOKEN=
WORKER_URL=https://minefeed-dev.kakouto4elovek.workers.dev
# same value as the Worker secret BOT_SECRET
BOT_SECRET=
GUILD_ID=1525462612920504420
# categories whose forums are MineFeed spaces (feed + communities), comma separated
FEED_CATEGORY_IDS=1567658245609226250,1567658247928807444
# Discord role that can moderate MineFeed from the mod
MOD_ROLE_ID=1567664207342604449
# news channel for release announcements of our mods (empty = off)
ANNOUNCE_CHANNEL_ID=1567664222752735342
# only releases published after this moment are announced (set it to the deploy time)
RELEASES_SINCE=
# self-service ping roles for the "ping:<key>" buttons; keys match the projects in releases.js
PING_ROLES=minefeed:1568042879908061279,retroconsole:1568042882072449066
# per-mod release history channels: every version is posted there once, oldest first (no ping)
RELEASE_CHANNELS=
